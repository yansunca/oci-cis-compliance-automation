# OCI provider authentication is read from the normal OCI CLI config/profile or Resource Manager.
tenancy_ocid   = "ocid1.tenancy.oc1..example"
compartment_id = "ocid1.compartment.oc1..example"
region         = "us-ashburn-1"
region_key     = "iad"
# Optional. Leave empty/commented for commercial regions. Gov Cloud example:
# registry_host = "ocir.us-langley-1.oci.oraclegovcloud.com"
name_prefix                = "cis-auto"
image_tag                  = "v1"
loader_image_tag           = "v1"
# Optional: pin scheduled scans to an immutable runner image digest.
# runner_image_uri = "iad.ocir.io/<namespace>/cis-auto-runner@sha256:<digest>"
container_shape            = "CI.Standard.E4.Flex"
existing_private_subnet_id = "ocid1.subnet.oc1..example"

# Required. Use a new, strong password; Terraform marks it sensitive and places
# it in OCI Vault for the ingestion Function at runtime.
adb_admin_password = "ReplaceWith-A-Strong-Password1"

adb_db_name                = "CISAUTOMATION"
adb_ecpu_count             = 2
adb_data_storage_size_in_tbs = 1
adb_service_level          = "LOW"

# Optional. Leave commented out to use the Function subnet's security lists instead.
# existing_network_security_group_id = "ocid1.networksecuritygroup.oc1..example"

# Optional. Functions always use existing_private_subnet_id. Set these only if
# scanner Container Instances need a different subnet/NSG for egress.
# scanner_subnet_id = "ocid1.subnet.oc1..scanner-example"
# scanner_network_security_group_id = "ocid1.networksecuritygroup.oc1..scanner-example"

# Optional. For Gov/private deployments, create ADB with private endpoint access.
# Leave these empty/commented for secure public mTLS access.
# adb_private_endpoint_subnet_id = "ocid1.subnet.oc1..example"
# adb_private_endpoint_nsg_ids = ["ocid1.networksecuritygroup.oc1..example"]
# adb_private_endpoint_label = "cis-adb"

# Optional. Create an OCI DNS Resolver inbound endpoint so VPN/corporate DNS
# can forward private ADB/APEX lookups into the VCN. The customer DNS/VPN team
# still needs to configure conditional forwarding to the output IP.
# create_dns_resolver_inbound_endpoint = true
# dns_resolver_endpoint_subnet_id = "ocid1.subnet.oc1..dns-example"
# dns_resolver_endpoint_nsg_id = "ocid1.networksecuritygroup.oc1..dns-example"
# dns_resolver_allowed_cidrs = ["192.0.2.10/32"]
# dns_resolver_endpoint_listening_address = "10.120.30.10"

# Sunday 02:00 UTC
schedule_cron = "0 2 * * 0"

# All is valid; a comma-separated region list reduces the scope and runtime.
cis_regions = "All"

# Scanner output and evidence options.
cis_all_resources = true
cis_debug        = false
object_prefix    = ""
run_prefix       = "CIS-CI"
assign_public_ip = false
